{
  "name": "@local/dsh-prompt-forecast",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "description": "Ghost-text next-action prediction in the DeepSeek Harness Web composer, accepted with Tab or Right Arrow.",
  "license": "MIT",
  "author": "littepoint",
  "homepage": "https://github.com/littepointR/dsh-prompt-forecast#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/littepointR/dsh-prompt-forecast.git"
  },
  "bugs": {
    "url": "https://github.com/littepointR/dsh-prompt-forecast/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "prompt",
    "prediction",
    "composer"
  ],
  "engines": {
    "dsh": "^0.2.1-rc.2"
  },
  "scripts": {
    "test": "node --test test/host.test.mjs test/client.test.mjs",
    "check": "node --check index.js && node --check client.js && node --check test/host.test.mjs && node --check test/client.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
